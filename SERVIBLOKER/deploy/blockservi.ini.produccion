[general]
domain = example.com
portal_host = portal.example.com
device_dns_suffix = dns.example.com
device_prefix = dev-
admin_key = CAMBIA-ESTA-CLAVE-LARGA-Y-ALEATORIA
data_dir = /var/lib/blockservi
state_file = /var/lib/blockservi/devices.json
licenses_file = /var/lib/blockservi/licenses.json
policy_file = /var/lib/blockservi/policy.json
log_file = /var/lib/blockservi/blocked.log
log_max_bytes = 8388608
unlock_hours = 24
request_hours = 24
doh_path = /dns-query
; IP públicas reales de HTTPS DoH; obligatorias al habilitar VPN.
doh_server_addresses =
blocked_rcode = nxdomain
captive_ip =
; Sólo habilitar temporalmente para perfiles compartidos antiguos: no aísla NAT.
trust_ip = false
legacy_admin_query = false

[network]
http_host = 127.0.0.1
http_port = 8080
plain_host = 127.0.0.1
plain_port = 5353
; Sólo proxies administrados que sobrescriben/sanean X-Forwarded-For.
trusted_proxies = 127.0.0.1/32,::1/128

[upstream]
doh = https://1.1.1.1/dns-query,https://dns.google/dns-query
udp =
timeout = 5
cache_ttl = 300
cache_max = 20000

[vpn]
vpn_enabled = false
vpn_address = vpn.example.com
vpn_remote = vpn.example.com
credentials_dir = /var/lib/blockservi/credentials
ca_file = /var/lib/blockservi/vpn-ca.der
