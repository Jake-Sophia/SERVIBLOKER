[Unit]
Description=IBLOKER individual VPN firewall and DNS bridge
After=network-online.target blockservi.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/blockservi/.venv/bin/python /usr/local/lib/iblocker-delivery/guard.py
Restart=on-failure
RestartSec=2
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
