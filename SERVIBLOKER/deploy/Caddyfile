# Ejemplo: adaptar host y conservar la configuración del proxy ya existente.
portal.example.com {
    reverse_proxy 127.0.0.1:8080
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    # Sin access log: las rutas de dispositivos contienen credenciales bearer.
}
# Conservar los hosts individuales antiguos si existen perfiles instalados.
import /etc/caddy/dispositivos/*.caddy
